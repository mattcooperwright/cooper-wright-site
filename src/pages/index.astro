---
import Base from '../layouts/Base.astro';
import KaleidoscopeBackground from '../components/KaleidoscopeBackground.astro';
import Tile from '../components/Tile.astro';
import { homePages, tileFontRole } from '../lib/home';
import { getListedPages } from '../lib/pages';

const pages = homePages(await getListedPages());
// body for the shared nav text, plain for the home page's own heading and default tiles,
// plus any other font roles the tiles use.
const fonts = [
  ...new Set(['body' as const, 'plain' as const, ...pages.map((p) => tileFontRole(p.data.indexStyle?.fontFamily))]),
];
---
<Base title="Matt Cooper-Wright" fonts={fonts} fullBleed navFixed>
  <KaleidoscopeBackground />
  <div class="mx-auto max-w-6xl px-4 pt-12 pb-64">
    <div class="mb-8 inline-block bg-white px-4 py-2 shadow-sm" style="font-family: var(--font-plain)">
      <!-- One word per line; the spans keep the accessible name "Matt Cooper-Wright". -->
      <h1
        class="pb-[0.12em] text-[clamp(3rem,17vw,14rem)] leading-[0.85] font-semibold tracking-[-0.075em] text-transparent [-webkit-text-stroke:2px_var(--color-neutral-900)]"
      >
        <span class="block">Matt</span><span class="block">Cooper-</span><span class="block">Wright</span>
      </h1>
    </div>
    <ul class="grid grid-cols-[minmax(0,1fr)] gap-6 md:grid-cols-2 lg:grid-cols-3">
      {pages.map((page) => (
        <li><Tile page={page} /></li>
      ))}
    </ul>
  </div>
</Base>
