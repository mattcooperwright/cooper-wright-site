---
import Base from '../layouts/Base.astro';
import { getListedPages, isExternal, pageHref } from '../lib/pages';

const pages = (await getListedPages()).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base title="Matt Cooper-Wright">
  <h1 class="mb-8 text-3xl font-semibold">Matt Cooper-Wright</h1>
  <ul class="grid gap-4">
    {pages.map((page) => (
      <li>
        <a
          href={pageHref(page)}
          class="block rounded p-4 border border-neutral-200"
          style={page.data.indexStyle}
          {...(isExternal(page) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <span class="block font-semibold">{page.data.title}</span>
          <span class="block">{page.data.description}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
