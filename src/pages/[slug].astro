---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import PostLayout from '../layouts/PostLayout.astro';
import {
  getSlugRoutePages,
  loadMdPayload,
  loadMdxPayload,
  loadReactPayload,
  type Page,
} from '../lib/pages';

export const getStaticPaths = (async () => {
  const pages = await getSlugRoutePages();
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page };
const { type } = page.data;
// React pages without hydrate render to static HTML with no client JS.
const Component = type === 'react' ? await loadReactPayload(page) : null;
const Content = type === 'mdx' ? await loadMdxPayload(page) : null;
const md = type === 'md' ? await loadMdPayload(page) : null;
---
{md ? (
  <PostLayout page={page} markdown={md.rawContent()}>
    <md.Content />
  </PostLayout>
) : Component ? (
  <Base title={page.data.title} page={page} fullBleed>
    <Component />
  </Base>
) : Content && (
  <Base title={page.data.title} page={page}>
    <article class="[&_p]:mb-4">
      <h1 class="mb-6 text-3xl font-semibold">{page.data.title}</h1>
      <Content />
    </article>
    <p class="mt-12"><a href="/" class="underline">Back to home</a></p>
  </Base>
)}
