---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import { getBuildPages, loadMdxPayload, type Page } from '../lib/pages';

export const getStaticPaths = (async () => {
  const pages = await getBuildPages();
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page };
const Content = await loadMdxPayload(page);
---
<Base title={page.data.title} page={page}>
  <article class="[&_p]:mb-4">
    <h1 class="mb-6 text-3xl font-semibold">{page.data.title}</h1>
    <Content />
  </article>
  <p class="mt-12"><a href="/" class="underline">Back to home</a></p>
</Base>
