---
// Section index pages: /writing/, /projects/ and /experiments/. Every published page in the
// section as a tile, over the home page backdrop. Writing uses the red, green and blue palette.
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import KaleidoscopeBackground from '../components/KaleidoscopeBackground.astro';
import Tile from '../components/Tile.astro';
import { SECTIONS } from '../lib/manifest';
import { tileFontRole } from '../lib/home';
import { byMenuOrderThenNewest, getSectionPages, sectionSlug, type Section } from '../lib/pages';

export const getStaticPaths = (() =>
  SECTIONS.map((section) => ({ params: { section: sectionSlug(section) }, props: { section } }))) satisfies GetStaticPaths;

const { section } = Astro.props as { section: Section };
const pages = (await getSectionPages(section)).sort(byMenuOrderThenNewest);
const fonts = [
  ...new Set(['body' as const, 'plain' as const, ...pages.map((p) => tileFontRole(p.data.indexStyle?.fontFamily))]),
];
---
<Base title={`${section}: Matt Cooper-Wright`} fonts={fonts} fullBleed>
  <KaleidoscopeBackground palette={section === 'Writing' ? 'rgb' : 'default'} />
  <div class="mx-auto max-w-6xl px-4 pt-12 pb-12">
    <div class="mb-8 inline-block bg-white px-4 py-2 shadow-sm" style="font-family: var(--font-plain)">
      <h1 class="text-3xl font-semibold">{section}</h1>
    </div>
    {pages.length === 0 ? (
      <p class="inline-block bg-white px-4 py-2 shadow-sm">Nothing here yet.</p>
    ) : (
      <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {pages.map((page) => (
          <li><Tile page={page} /></li>
        ))}
      </ul>
    )}
  </div>
</Base>
