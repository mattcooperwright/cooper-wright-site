---
// One home page tile. Restyle every tile by editing this file.
// The title is the tile's only link; its ::after overlay makes the whole tile clickable.
import { SECTIONS } from '../lib/manifest';
import { TILE_DEFAULTS, tileFontRole } from '../lib/home';
import { isExternal, pageHref, type Page } from '../lib/pages';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const { title, description, section, image, indexStyle } = page.data;
const external = isExternal(page);
const background = indexStyle?.background ?? TILE_DEFAULTS.background;
const color = indexStyle?.color ?? TILE_DEFAULTS.color;
const fontFamily = `var(--font-${tileFontRole(indexStyle?.fontFamily)})`;
const hasTag = Boolean(section && (SECTIONS as readonly string[]).includes(section));

// The section tag is a fixed-size chip (not sized to its text) so this same box, in
// pixels, can also cut the exact hole for it out of the background fill below.
const TAG_BOX = { left: 20, top: 20, width: 112, height: 24, radius: 3 };
const tagMask = `${TAG_BOX.width}px ${TAG_BOX.height}px`;
const tagPosition = `${TAG_BOX.left}px ${TAG_BOX.top}px`;

// A rounded rect, not a plain gradient box, so the cut-out hole gets the same slightly
// softened corners as the tile itself rather than a hard-edged rectangle.
const holeShape = `url("data:image/svg+xml,${encodeURIComponent(
  `<svg xmlns='http://www.w3.org/2000/svg' width='${TAG_BOX.width}' height='${TAG_BOX.height}'><rect width='${TAG_BOX.width}' height='${TAG_BOX.height}' rx='${TAG_BOX.radius}' ry='${TAG_BOX.radius}' fill='#000'/></svg>`,
)}")`;

const backgroundStyle = hasTag
  ? {
      background,
      maskImage: `linear-gradient(#000, #000), ${holeShape}`,
      maskSize: `100% 100%, ${tagMask}`,
      maskPosition: `0 0, ${tagPosition}`,
      maskRepeat: 'no-repeat, no-repeat',
      maskComposite: 'exclude',
      WebkitMaskImage: `linear-gradient(#000, #000), ${holeShape}`,
      WebkitMaskSize: `100% 100%, ${tagMask}`,
      WebkitMaskPosition: `0 0, ${tagPosition}`,
      WebkitMaskRepeat: 'no-repeat, no-repeat',
      WebkitMaskComposite: 'xor',
    }
  : { background };
---
<article
  class="relative flex aspect-square flex-col overflow-hidden rounded-[18px] shadow-sm transition-shadow hover:shadow-lg focus-within:ring-2 focus-within:ring-current"
  style={{ color, fontFamily }}
>
  {/* Background fill, with a hole cut exactly where the tag sits (see below), so the
      fixed page background shows through — a real window, not a translucent tint. */}
  <div class="absolute inset-0" style={backgroundStyle} />
  {image && (
    <img src={image} alt={title} loading="lazy" decoding="async" class="relative aspect-[16/9] w-full object-cover" />
  )}
  {hasTag && (
    <p
      class="absolute flex items-center justify-center font-body text-xs uppercase tracking-wide text-[#1a1a1a]"
      style={{ left: `${TAG_BOX.left}px`, top: `${TAG_BOX.top}px`, width: `${TAG_BOX.width}px`, height: `${TAG_BOX.height}px` }}
    >
      {section}
    </p>
  )}
  <div class="relative flex flex-1 flex-col gap-2 p-5 pt-14">
    <h2 class="text-[3em] font-semibold leading-none break-words">
      <a
        href={pageHref(page)}
        class="outline-none after:absolute after:inset-0 after:content-['']"
        {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        {title}{external && <span aria-hidden="true"> ↗</span>}
        {external && <span class="sr-only"> (opens in a new tab)</span>}
      </a>
    </h2>
    <p class="line-clamp-5 opacity-80">{description}</p>
  </div>
</article>
