---
// The site menu, shared by Base.astro and HtmlShell.astro.
//
// A slim near-black rail (left on desktop, a bar across the top on mobile) with Home and one
// label per section. Clicking or tapping a section opens a small menu of just that section's
// page titles. The open label turns into a white chip so it is clear which one the list belongs to.
//   Desktop: the list opens beside the rail, its first title level with the chosen label.
//   Mobile: the list drops from the bar at full width, one 44px row per title.
//   Click the label again, click anywhere outside, or press Escape to close. With the menu open,
//   hovering another label on desktop switches to it.
//   Keyboard: labels are buttons (aria-expanded); Tab moves from a label into its list.
// Without JavaScript each section label is a plain link to its section page.
//
// Styles and script are inline and use no Tailwind classes, because HtmlShell's CSP has no
// 'self' and cannot load the site's stylesheet or bundled scripts. The font is the mono role,
// falling back to the system mono stack where the role isn't defined (HtmlShell).
import { SECTIONS } from '../lib/manifest';
import { isExternal, pageHref, sectionSlug, type MenuGroup, type Section } from '../lib/pages';

interface Props {
  groups: MenuGroup[];
  // Current path without a trailing slash: '' for home, '/writing', '/tek-tek'.
  current: string;
}

const { groups, current } = Astro.props;

const isSection = (label: string): label is Section => (SECTIONS as readonly string[]).includes(label);
const slug = (label: string) => label.toLowerCase();
const sectionPath = (label: string) => (isSection(label) ? `/${sectionSlug(label)}` : null);
const inGroup = (group: MenuGroup) =>
  current === sectionPath(group.label) || group.pages.some((p) => current === `/${p.id}`);
---
<div class="sm-layer" data-sm-layer aria-hidden="true"></div>
<nav class="sm" aria-label="Main" data-sm>
  <ul class="sm-rail">
    <li><a class="sm-link" href="/" aria-current={current === '' ? 'page' : undefined}>Home</a></li>
    {groups.map((group) => (
      <li data-sm-item>
        {isSection(group.label) ? (
          <a
            class="sm-link sm-trigger"
            href={`/${sectionSlug(group.label)}/`}
            data-sm-trigger
            aria-controls={`sm-menu-${slug(group.label)}`}
            aria-expanded="false"
            data-current={inGroup(group) ? '' : undefined}
          >
            {group.label}
          </a>
        ) : (
          // A group with no section page has nothing to link to without JavaScript, so it is a button.
          <button
            type="button"
            class="sm-link sm-trigger"
            data-sm-trigger
            aria-controls={`sm-menu-${slug(group.label)}`}
            aria-expanded="false"
            data-current={inGroup(group) ? '' : undefined}
          >
            {group.label}
          </button>
        )}
        <ul class="sm-panel" id={`sm-menu-${slug(group.label)}`} data-sm-panel aria-label={group.label}>
          {group.pages.map((item) => (
            <li>
              <a
                class="sm-page"
                href={pageHref(item)}
                aria-current={current === `/${item.id}` ? 'page' : undefined}
                {...(isExternal(item) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {item.data.title}
                {isExternal(item) && (
                  <>
                    {' '}<span aria-hidden="true">↗</span><span class="sm-sr">(opens in a new tab)</span>
                  </>
                )}
              </a>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</nav>

<style is:inline>
  :root { --sm-rail: 9rem; }
  .sm, .sm * { box-sizing: border-box; }
  /* One size, all caps, regular weight. Hierarchy comes from colour alone: page titles and
     active items white, rail labels mid grey. Each grey keeps at least 4.5:1 contrast. */
  .sm {
    --sm-bg: #111; --sm-fg: #f5f5f5; --sm-mid: #a6a6a6; --sm-line: #2a2a2a;
    position: sticky; top: 0; z-index: 1000;
    background: var(--sm-bg); color: var(--sm-fg);
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
    font-size: 12px; font-weight: 400; line-height: 1.5; letter-spacing: 0.05em; text-transform: uppercase;
  }
  .sm :where(ul) { list-style: none; margin: 0; padding: 0; }
  .sm a { text-decoration: none; }
  .sm a:focus-visible, .sm button:focus-visible { outline: 2px solid var(--sm-fg); outline-offset: 3px; }
  .sm-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .sm-rail { display: flex; flex-wrap: wrap; gap: 6px 24px; padding: 14px 16px; }
  /* Rail labels carry 2px 8px padding with matching negative margin, so the open state's chip
     can fill without anything shifting. */
  .sm .sm-link {
    display: inline-block; margin: -2px -8px; padding: 2px 8px; border: 0; border-radius: 2px;
    background: none; font: inherit; letter-spacing: inherit; text-transform: inherit; text-align: left;
    color: var(--sm-mid); cursor: pointer; text-underline-offset: 3px;
  }
  .sm .sm-link:hover { color: var(--sm-fg); }
  .sm .sm-link[aria-current], .sm .sm-trigger[data-current] { color: var(--sm-fg); text-decoration: underline; }
  /* Open: an inverted chip, the same white label as the tags on the home page tiles. */
  .sm .sm-trigger[aria-expanded="true"] { background: var(--sm-fg); color: var(--sm-bg); }

  /* A section's menu: just its page titles, as small as its list needs. */
  .sm-panel {
    position: absolute; top: 100%; left: 0; right: 0; max-height: 70dvh; overflow-y: auto; overscroll-behavior: contain;
    background: var(--sm-bg); border-top: 1px solid var(--sm-line); border-bottom: 1px solid var(--sm-line);
    visibility: hidden; opacity: 0; transform: translateY(-6px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0s linear 0.15s;
  }
  .sm-panel[data-open] { visibility: visible; opacity: 1; transform: none; transition: opacity 0.15s ease, transform 0.15s ease; }
  .sm .sm-page { display: flex; align-items: center; min-height: 44px; padding: 8px 16px; color: var(--sm-fg); text-underline-offset: 3px; }
  .sm-panel li + li .sm-page { border-top: 1px solid var(--sm-line); }
  .sm .sm-page:hover, .sm .sm-page[aria-current] { text-decoration: underline; }

  /* Catches the click that closes the menu. Transparent, and above sandboxed html pages' iframes,
     which would otherwise swallow it. */
  .sm-layer { position: fixed; inset: 0; z-index: 999; visibility: hidden; }
  .sm-layer[data-open] { visibility: visible; }

  @media (min-width: 768px) {
    body { padding-left: var(--sm-rail); }
    .sm { position: fixed; top: 0; bottom: 0; left: 0; width: var(--sm-rail); }
    .sm-rail { flex-direction: column; flex-wrap: nowrap; gap: 10px; padding: 32px 24px; }
    .sm-rail li:first-child { margin-bottom: 14px; }
    /* Opens beside the rail. The script sets top so the first title sits level with the label. */
    .sm-panel {
      top: 0; left: 100%; right: auto; min-width: 16rem; max-width: calc(100vw - var(--sm-rail) - 24px);
      padding: 12px 20px; border: 1px solid var(--sm-line); border-left: 0;
      transform: translateX(-6px);
    }
    .sm .sm-page { min-height: 0; padding: 2px 0; }
    .sm-panel li + li { margin-top: 8px; }
    .sm-panel li + li .sm-page { border-top: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sm-panel, .sm-panel[data-open] { transition: none; transform: none; }
  }
</style>

<script is:inline>
  (() => {
    const nav = document.querySelector('[data-sm]');
    const layer = document.querySelector('[data-sm-layer]');
    if (!nav || !layer) return;

    const items = [...nav.querySelectorAll('[data-sm-item]')].map((li) => ({
      trigger: li.querySelector('[data-sm-trigger]'),
      panel: li.querySelector('[data-sm-panel]'),
    })).filter((i) => i.trigger && i.panel);
    const narrow = window.matchMedia('(max-width: 767.98px)');
    // Panel padding plus border above the first title, so it lines up with the rail label.
    const TOP_OFFSET = 13;

    let openItem = null;

    // Labels act as buttons once the script is running. Without it they stay plain links.
    for (const { trigger } of items) {
      if (trigger.tagName === 'A') trigger.setAttribute('role', 'button');
    }

    function place({ trigger, panel }) {
      if (narrow.matches) {
        panel.style.top = '';
        panel.style.maxHeight = '';
        return;
      }
      const top = Math.max(0, trigger.offsetTop - TOP_OFFSET);
      panel.style.top = top + 'px';
      panel.style.maxHeight = Math.max(160, window.innerHeight - top - 16) + 'px';
    }

    function close() {
      if (!openItem) return;
      openItem.trigger.setAttribute('aria-expanded', 'false');
      openItem.panel.removeAttribute('data-open');
      layer.removeAttribute('data-open');
      openItem = null;
    }

    function open(item) {
      if (openItem === item) return;
      close();
      place(item);
      item.trigger.setAttribute('aria-expanded', 'true');
      item.panel.setAttribute('data-open', '');
      layer.setAttribute('data-open', '');
      item.panel.scrollTop = 0;
      openItem = item;
    }

    for (const item of items) {
      item.trigger.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return; // let "open in new tab" through
        e.preventDefault();
        if (openItem === item) close();
        else open(item);
      });
      // With the menu open on desktop, moving to another label switches to it.
      item.trigger.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse' && openItem && openItem !== item && !narrow.matches) open(item);
      });
    }

    layer.addEventListener('click', close);

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !openItem) return;
      const { trigger, panel } = openItem;
      const hadFocusInside = panel.contains(document.activeElement);
      close();
      if (hadFocusInside) trigger.focus({ preventScroll: true });
    });

    // Tabbing out of the open label and its list closes it.
    nav.addEventListener('focusout', (e) => {
      if (!openItem || !e.relatedTarget) return;
      if (e.relatedTarget === openItem.trigger || openItem.panel.contains(e.relatedTarget)) return;
      close();
    });

    narrow.addEventListener('change', close);
    window.addEventListener('resize', () => { if (openItem) place(openItem); });
    window.addEventListener('pageshow', close);
  })();
</script>
