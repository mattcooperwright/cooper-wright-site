---
// The site menu, shared by Base.astro and HtmlShell.astro.
//
// Collapsed, it is a slim near-black rail (left on desktop, a top bar on mobile) with Home
// and the top-level sections only. Expanded, an index panel lists every page by section,
// like a site map. It never covers the whole screen: a strip of the site stays visible
// under a light scrim.
//   Desktop with a mouse: hovering the rail opens the index; moving off it closes it.
//   Touch or narrow screens: tapping a section opens the index at that section; tapping
//   the visible site (the scrim) or the same section again closes it.
//   Keyboard: tabbing into the menu opens it; Escape or tabbing out closes it.
// Without JavaScript the rail still works: Home and each section link to their pages.
//
// Styles and script are inline and use no Tailwind classes, because HtmlShell's CSP has no
// 'self' and cannot load the site's stylesheet or bundled scripts. The font is the mono role,
// falling back to the system mono stack where the role isn't defined (HtmlShell).
import { SECTIONS } from '../lib/manifest';
import { isExternal, pageHref, sectionSlug, type MenuGroup, type Section } from '../lib/pages';

interface Props {
  groups: MenuGroup[];
  // Current path without a trailing slash: '' for home, '/writing', '/tek-tek'.
  current: string;
}

const { groups, current } = Astro.props;

const isSection = (label: string): label is Section => (SECTIONS as readonly string[]).includes(label);
const groupId = (label: string) => `site-index-${label.toLowerCase()}`;
const groupHref = (label: string) => (isSection(label) ? `/${sectionSlug(label)}/` : `#${groupId(label)}`);
const sectionPath = (label: string) => (isSection(label) ? `/${sectionSlug(label)}` : null);
const inGroup = (group: MenuGroup) =>
  current === sectionPath(group.label) || group.pages.some((p) => current === `/${p.id}`);
const pad = (n: number) => String(n).padStart(2, '0');
const total = groups.reduce((n, g) => n + g.pages.length, 0);
---
<div class="sm-scrim" data-sm-scrim aria-hidden="true"></div>
<nav class="sm" aria-label="Main" data-sm>
  <ul class="sm-rail">
    <li><a class="sm-home" href="/" aria-current={current === '' ? 'page' : undefined}>Home</a></li>
    {groups.map((group) => (
      <li>
        <a
          class="sm-section"
          href={groupHref(group.label)}
          data-sm-section={groupId(group.label)}
          aria-controls="site-index"
          aria-expanded="false"
          aria-current={current === sectionPath(group.label) ? 'page' : inGroup(group) ? 'true' : undefined}
        >
          {group.label}
        </a>
      </li>
    ))}
  </ul>
  <div id="site-index" class="sm-panel" data-sm-panel>
    <p class="sm-kicker">Index <span>{pad(total)}</span></p>
    <div class="sm-index">
      {groups.map((group) => (
        <section class="sm-group" id={groupId(group.label)} data-sm-group aria-labelledby={`${groupId(group.label)}-label`}>
          <h2 class="sm-group-label" id={`${groupId(group.label)}-label`}>
            {isSection(group.label) ? <a href={groupHref(group.label)}>{group.label}</a> : group.label}
            <span>{pad(group.pages.length)}</span>
          </h2>
          <ul>
            {group.pages.map((item) => (
              <li>
                <a
                  class="sm-page"
                  href={pageHref(item)}
                  aria-current={current === `/${item.id}` ? 'page' : undefined}
                  {...(isExternal(item) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <span class="sm-title">
                    {item.data.title}
                    {isExternal(item) && (
                      <>
                        {' '}<span aria-hidden="true">↗</span><span class="sm-sr">(opens in a new tab)</span>
                      </>
                    )}
                  </span>
                  {item.data.description && <span class="sm-desc">{item.data.description}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</nav>

<style is:inline>
  :root { --sm-rail: 9rem; }
  .sm, .sm * { box-sizing: border-box; }
  .sm {
    --sm-bg: #111; --sm-fg: #f5f5f5; --sm-dim: #8a8a8a; --sm-line: #2a2a2a;
    position: sticky; top: 0; z-index: 1000;
    background: var(--sm-bg); color: var(--sm-fg);
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
    font-size: 12px; line-height: 1.4; letter-spacing: 0.05em;
  }
  .sm a { color: inherit; text-decoration: none; }
  .sm a:focus-visible { outline: 2px solid var(--sm-fg); outline-offset: 3px; }
  .sm :where(ul) { list-style: none; margin: 0; padding: 0; }
  .sm-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .sm-rail { display: flex; flex-wrap: wrap; gap: 6px 24px; padding: 14px 16px; text-transform: uppercase; }
  .sm-home { font-weight: 600; }
  .sm-rail a { text-underline-offset: 3px; }
  .sm-rail a:hover, .sm-rail a[aria-current], .sm-rail a[data-active] { text-decoration: underline; }

  .sm-panel {
    position: absolute; top: 100%; left: 0; right: 0; height: 78dvh;
    overflow-y: auto; overscroll-behavior: contain;
    background: var(--sm-bg); border-top: 1px solid var(--sm-line);
    padding: 24px 16px 48px;
    visibility: hidden; opacity: 0; transform: translateY(-8px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0s linear 0.18s;
  }
  .sm[data-open] .sm-panel {
    visibility: visible; opacity: 1; transform: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  .sm-kicker {
    display: flex; gap: 12px; margin: 0 0 28px;
    font-size: 11px; color: var(--sm-dim); text-transform: uppercase;
  }
  .sm-index { display: grid; gap: 40px 48px; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); max-width: 80rem; }
  .sm-group-label {
    display: flex; justify-content: space-between; gap: 12px;
    margin: 0 0 18px; padding-bottom: 8px; border-bottom: 1px solid var(--sm-line);
    font: inherit; font-size: 11px; font-weight: 400; color: var(--sm-dim); text-transform: uppercase;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .sm-group-label a:hover { color: var(--sm-fg); text-decoration: underline; text-underline-offset: 3px; }
  .sm-group[data-active] .sm-group-label { color: var(--sm-fg); border-color: var(--sm-fg); }
  .sm-group ul { display: grid; gap: 20px; }
  .sm-page { display: block; }
  .sm-title {
    display: block; font-size: clamp(1.25rem, 2.1vw, 1.75rem); line-height: 1.15; letter-spacing: -0.01em;
    text-underline-offset: 0.15em; text-decoration-thickness: 1px;
  }
  .sm-page:hover .sm-title, .sm-page[aria-current] .sm-title { text-decoration: underline; }
  .sm-desc {
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
    margin-top: 6px; max-width: 42ch; color: var(--sm-dim); line-height: 1.45; letter-spacing: 0.02em;
  }

  .sm-scrim {
    position: fixed; inset: 0; z-index: 999; background: rgba(17, 17, 17, 0.22);
    visibility: hidden; opacity: 0;
    transition: opacity 0.18s ease, visibility 0s linear 0.18s;
  }
  .sm-scrim[data-open] { visibility: visible; opacity: 1; transition: opacity 0.18s ease; }

  @media (min-width: 768px) {
    body { padding-left: var(--sm-rail); }
    .sm { position: fixed; top: 0; bottom: 0; left: 0; width: var(--sm-rail); }
    .sm-rail { flex-direction: column; flex-wrap: nowrap; gap: 10px; padding: 32px 24px; }
    .sm-rail li:first-child { margin-bottom: 14px; }
    .sm-panel {
      top: 0; bottom: 0; left: 100%; right: auto; height: auto;
      width: calc(100vw - var(--sm-rail) - max(12vw, 6rem));
      padding: 32px 48px 64px; border-top: 0; border-left: 1px solid var(--sm-line);
      transform: translateX(-12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sm-panel, .sm[data-open] .sm-panel, .sm-scrim, .sm-scrim[data-open], .sm-group-label { transition: none; transform: none; }
  }
</style>

<script is:inline>
  (() => {
    const nav = document.querySelector('[data-sm]');
    const scrim = document.querySelector('[data-sm-scrim]');
    const panel = nav && nav.querySelector('[data-sm-panel]');
    if (!nav || !scrim || !panel) return;

    const sections = [...nav.querySelectorAll('[data-sm-section]')];
    const groups = [...nav.querySelectorAll('[data-sm-group]')];
    const narrow = window.matchMedia('(max-width: 767.98px)');
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
    // Narrow screens, and wide ones without a hovering pointer, open by tapping a section.
    const tapMode = () => narrow.matches || !canHover.matches;

    let openTimer = 0;
    let closeTimer = 0;
    let active = null;

    const isOpen = () => nav.hasAttribute('data-open');

    function highlight(id) {
      active = id;
      for (const a of sections) a.toggleAttribute('data-active', isOpen() && a.dataset.smSection === id);
      for (const g of groups) g.toggleAttribute('data-active', isOpen() && g.id === id);
    }

    function open(id) {
      clearTimeout(closeTimer);
      nav.setAttribute('data-open', '');
      scrim.setAttribute('data-open', '');
      for (const a of sections) a.setAttribute('aria-expanded', 'true');
      highlight(id);
      if (id && narrow.matches) {
        const g = document.getElementById(id);
        if (g) panel.scrollTop = Math.max(0, g.offsetTop - 24);
      }
    }

    function close() {
      clearTimeout(openTimer);
      clearTimeout(closeTimer);
      nav.removeAttribute('data-open');
      scrim.removeAttribute('data-open');
      for (const a of sections) a.setAttribute('aria-expanded', 'false');
      highlight(null);
    }

    // Desktop hover: a short delay each way so passing the cursor over the rail doesn't flash it.
    nav.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse' || tapMode()) return;
      clearTimeout(closeTimer);
      if (!isOpen()) openTimer = setTimeout(() => open(active), 70);
    });
    nav.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse' || tapMode()) return;
      clearTimeout(openTimer);
      closeTimer = setTimeout(close, 220);
    });

    for (const a of sections) {
      const id = a.dataset.smSection;
      // Hovering a section in the rail picks out its group in the index.
      a.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse' && !tapMode()) {
          active = id;
          if (isOpen()) highlight(id);
        }
      });
      a.addEventListener('click', (e) => {
        if (!tapMode()) return; // With a mouse the index is already open; the click goes to the section page.
        e.preventDefault();
        if (isOpen() && active === id) close();
        else open(id);
      });
    }

    scrim.addEventListener('click', close);

    // Keyboard: tabbing in opens the index, tabbing out closes it.
    nav.addEventListener('focusin', (e) => {
      if (!e.target.matches(':focus-visible')) return;
      const id = tapMode() ? null : e.target.dataset.smSection || active;
      if (!isOpen()) open(id);
      else if (!tapMode() && e.target.dataset.smSection) highlight(e.target.dataset.smSection);
    });
    nav.addEventListener('focusout', (e) => {
      if (isOpen() && !nav.contains(e.relatedTarget) && e.relatedTarget) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !isOpen()) return;
      const returnTo = panel.contains(document.activeElement)
        ? sections.find((a) => a.dataset.smSection === active) || nav.querySelector('.sm-home')
        : null;
      close();
      if (returnTo) {
        returnTo.focus({ preventScroll: true });
        close(); // focusing the rail reopens it; Escape means closed.
      }
    });

    narrow.addEventListener('change', close);
    window.addEventListener('pageshow', close);
  })();
</script>
