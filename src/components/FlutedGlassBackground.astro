---
// Fixed backdrop behind the home page tile grid: a WebGL fragment shader that bends a slow,
// iridescent colour field into fine vertical ridges, like looking through reeded glass.
// Raw WebGL (no library), so it adds no dependency, the same spirit as a Canvas 2D effect.
// Freezes on a single frame when the visitor prefers reduced motion. Silently renders nothing
// if WebGL is unavailable or the shader fails to compile.
---
<canvas id="fluted-glass-bg" class="pointer-events-none fixed inset-0 -z-10 h-full w-full" aria-hidden="true"></canvas>
<script>
  const VERTEX_SRC = `
    attribute vec2 a_position;
    void main() {
      gl_Position = vec4(a_position, 0.0, 1.0);
    }
  `;

  const FRAGMENT_SRC = `
    precision mediump float;
    uniform vec2 u_resolution;
    uniform float u_time;
    uniform float u_fluteWidth;

    const float PI = 3.14159265;

    // A handful of large, soft-edged colour blobs drifting slowly — big enough that
    // bending their edges through the glass reads as "shape behind glass", not static.
    float blob(vec2 p, vec2 center, float radius) {
      float d = length(p - center);
      return smoothstep(radius, radius * 0.25, d);
    }

    float field(vec2 p, float t) {
      float v = 0.0;
      v += blob(p, vec2(sin(t * 0.6), cos(t * 0.5)) * 0.9, 1.0);
      v += blob(p, vec2(cos(t * 0.4 + 2.0), sin(t * 0.7 + 1.0)) * 1.0, 0.8) * 0.85;
      v += blob(p, vec2(sin(t * 0.5 + 4.0), cos(t * 0.3 + 3.0)) * 0.8, 0.7) * 0.7;
      return v;
    }

    vec3 palette(float t) {
      vec3 a = vec3(0.55, 0.50, 0.55);
      vec3 b = vec3(0.45, 0.45, 0.45);
      vec3 c = vec3(1.0, 1.0, 1.0);
      vec3 d = vec3(0.00, 0.33, 0.67);
      return a + b * cos(6.28318 * (c * t + d));
    }

    vec3 colourAt(vec2 uv, float t) {
      vec2 p = (uv * 2.0 - 1.0) * vec2(u_resolution.x / u_resolution.y, 1.0) * 1.6;
      return palette(field(p, t) * 0.3 + t * 0.03);
    }

    void main() {
      vec2 uv = gl_FragCoord.xy / u_resolution;
      float t = u_time * 0.08;

      float stripeX = gl_FragCoord.x / u_fluteWidth;
      float localX = fract(stripeX) - 0.5;
      float ridgePhase = localX * PI;
      float normalX = sin(ridgePhase);

      const float REFRACTION_STRENGTH = 0.03;
      vec2 refractedUV = uv + vec2(normalX * REFRACTION_STRENGTH, 0.0);

      vec3 color = colourAt(refractedUV, t);
      color = clamp(color * 1.05, 0.0, 1.0);

      float highlight = pow(max(cos(ridgePhase), 0.0), 4.0);
      color *= mix(0.78, 1.08, highlight);
      color += highlight * 0.05;

      gl_FragColor = vec4(color, 1.0);
    }
  `;

  const canvasEl = document.getElementById('fluted-glass-bg');

  if (canvasEl instanceof HTMLCanvasElement) {
    const canvas = canvasEl;
    const gl = (canvas.getContext('webgl') ??
      canvas.getContext('experimental-webgl')) as WebGLRenderingContext | null;

    if (gl) {
      const glCtx = gl;

      function createShader(type: number, source: string): WebGLShader | null {
        const shader = glCtx.createShader(type);
        if (!shader) return null;
        glCtx.shaderSource(shader, source);
        glCtx.compileShader(shader);
        if (!glCtx.getShaderParameter(shader, glCtx.COMPILE_STATUS)) {
          console.error(glCtx.getShaderInfoLog(shader));
          glCtx.deleteShader(shader);
          return null;
        }
        return shader;
      }

      function createProgram(vertSrc: string, fragSrc: string): WebGLProgram | null {
        const vertShader = createShader(glCtx.VERTEX_SHADER, vertSrc);
        const fragShader = createShader(glCtx.FRAGMENT_SHADER, fragSrc);
        if (!vertShader || !fragShader) return null;
        const program = glCtx.createProgram();
        if (!program) return null;
        glCtx.attachShader(program, vertShader);
        glCtx.attachShader(program, fragShader);
        glCtx.linkProgram(program);
        if (!glCtx.getProgramParameter(program, glCtx.LINK_STATUS)) {
          console.error(glCtx.getProgramInfoLog(program));
          glCtx.deleteProgram(program);
          return null;
        }
        return program;
      }

      const program = createProgram(VERTEX_SRC, FRAGMENT_SRC);

      if (program) {
        const prog = program;
        const positionLoc = glCtx.getAttribLocation(prog, 'a_position');
        const timeLoc = glCtx.getUniformLocation(prog, 'u_time');
        const resolutionLoc = glCtx.getUniformLocation(prog, 'u_resolution');
        const fluteWidthLoc = glCtx.getUniformLocation(prog, 'u_fluteWidth');

        if (positionLoc !== -1 && timeLoc && resolutionLoc && fluteWidthLoc) {
          const posLoc = positionLoc;
          const uTime = timeLoc;
          const uResolution = resolutionLoc;
          const uFluteWidth = fluteWidthLoc;
          const buffer = glCtx.createBuffer();

          if (buffer) {
            glCtx.bindBuffer(glCtx.ARRAY_BUFFER, buffer);
            glCtx.bufferData(glCtx.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), glCtx.STATIC_DRAW);
            glCtx.enableVertexAttribArray(posLoc);
            glCtx.vertexAttribPointer(posLoc, 2, glCtx.FLOAT, false, 0, 0);
            glCtx.useProgram(prog);

            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const MAX_DPR = 1.5;
            const TARGET_FLUTE_CSS_PX = 12;

            let fluteWidthPx = TARGET_FLUTE_CSS_PX;

            function resize() {
              const dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR);
              canvas.width = Math.round(window.innerWidth * dpr);
              canvas.height = Math.round(window.innerHeight * dpr);
              glCtx.viewport(0, 0, canvas.width, canvas.height);
              fluteWidthPx = TARGET_FLUTE_CSS_PX * dpr;
            }
            resize();
            window.addEventListener('resize', resize);

            function draw(now: number) {
              const t = reduceMotion ? 0 : now * 0.001;
              glCtx.uniform1f(uTime, t);
              glCtx.uniform2f(uResolution, canvas.width, canvas.height);
              glCtx.uniform1f(uFluteWidth, fluteWidthPx);
              glCtx.drawArrays(glCtx.TRIANGLES, 0, 3);
              if (!reduceMotion) requestAnimationFrame(draw);
            }
            requestAnimationFrame(draw);
          }
        }
      }
    }
  }
</script>
