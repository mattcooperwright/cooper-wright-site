---
// Shell for html pages: the site menu beside (or above) the payload in a sandboxed iframe.
// It loads no files of its own: the CSP below has no 'self', and the srcdoc iframe inherits
// the same policy. The menu's styles and its small open/close script are inline for that reason.
import HeadMeta from '../components/HeadMeta.astro';
import SiteMenu from '../components/SiteMenu.astro';
import { getMenuGroups, type Page } from '../lib/pages';

interface Props {
  page: Page;
  html: string;
}

const { page, html } = Astro.props;
const groups = await getMenuGroups();

const csp = [
  "default-src 'none'",
  "script-src https://cdnjs.cloudflare.com https://cdn.jsdelivr.net 'unsafe-inline'",
  "style-src 'unsafe-inline' https://fonts.googleapis.com",
  'font-src https://fonts.gstatic.com',
  'img-src data: blob:',
  "connect-src 'none'",
  "base-uri 'none'",
  "form-action 'none'",
].join('; ');
---
<!doctype html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <HeadMeta title={page.data.title} description={page.data.description} page={page} />
    <style is:inline>
      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; }
      /* The menu (SiteMenu.astro) brings its own inline styles: a top bar on narrow screens, and
         on wider ones a fixed left rail that pads the body. The payload iframe fills the rest. */
      body { display: flex; flex-direction: column; height: 100dvh; background: #111; }
      iframe { flex: 1; width: 100%; border: 0; display: block; }
    </style>
  </head>
  <body>
    <SiteMenu groups={groups} current={`/${page.id}`} />
    <iframe srcdoc={html} sandbox="allow-scripts" title={page.data.title}></iframe>
  </body>
</html>
