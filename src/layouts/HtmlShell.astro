---
// Shell for html pages: a slim site bar above the payload in a sandboxed iframe.
// It ships no JavaScript and loads no files of its own: the CSP below has no 'self',
// and the srcdoc iframe inherits the same policy.
import HeadMeta from '../components/HeadMeta.astro';
import { getMenuGroups, isExternal, pageHref, type Page } from '../lib/pages';

interface Props {
  page: Page;
  html: string;
}

const { page, html } = Astro.props;
const groups = await getMenuGroups();

const csp = [
  "default-src 'none'",
  "script-src https://cdnjs.cloudflare.com https://cdn.jsdelivr.net 'unsafe-inline'",
  "style-src 'unsafe-inline' https://fonts.googleapis.com",
  'font-src https://fonts.gstatic.com',
  'img-src data: blob:',
  "connect-src 'none'",
  "base-uri 'none'",
  "form-action 'none'",
].join('; ');
---
<!doctype html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <HeadMeta title={page.data.title} description={page.data.description} page={page} />
    <style is:inline>
      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; }
      /* Same near-black menu as Base.astro: a left column, or a top bar on narrow screens.
         The CSP has no 'self', so the menu can't load Roboto Mono here and uses the system mono stack. */
      body {
        display: flex; flex-direction: column; height: 100dvh;
        background: #111; color: #f5f5f5;
        font: 12px/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        text-transform: uppercase; letter-spacing: .05em;
      }
      .bar { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 20px; padding: 12px 16px; }
      .bar a { color: inherit; text-decoration: none; }
      .bar a:hover, .bar a[aria-current="page"] { text-decoration: underline; }
      .bar .home { font-weight: 600; }
      .bar ul { display: contents; list-style: none; }
      .bar .label { font-size: 11px; color: #737373; }
      @media (min-width: 768px) {
        body { flex-direction: row; }
        .bar {
          flex: 0 0 14rem; flex-direction: column; flex-wrap: nowrap; align-items: flex-start;
          gap: 6px; padding: 32px 24px; overflow-y: auto;
        }
        .bar ul { display: flex; flex-direction: column; gap: 6px; padding: 0; margin: 0; }
        .bar .label { margin-top: 14px; }
      }
      iframe { flex: 1; width: 100%; border: 0; display: block; }
    </style>
  </head>
  <body>
    <nav class="bar" aria-label="Main">
      <a class="home" href="/">Home</a>
      {groups.map((group) => (
        <>
          <span class="label">{group.label}</span>
          <ul>
            {group.pages.map((item) => (
              <li>
                {isExternal(item) ? (
                  <a href={pageHref(item)} target="_blank" rel="noopener noreferrer">{item.data.title} ↗</a>
                ) : (
                  <a href={pageHref(item)} aria-current={item.id === page.id ? 'page' : undefined}>{item.data.title}</a>
                )}
              </li>
            ))}
          </ul>
        </>
      ))}
    </nav>
    <iframe srcdoc={html} sandbox="allow-scripts" title={page.data.title}></iframe>
  </body>
</html>
