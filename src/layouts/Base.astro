---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { fontVariable, type FontRole } from '../lib/fonts';
import HeadMeta from '../components/HeadMeta.astro';
import SiteMenu from '../components/SiteMenu.astro';
import { getMenuGroups, type Page } from '../lib/pages';

interface Props {
  title: string;
  description?: string;
  page?: Page;
  // Font roles the layout needs, added to any the page's manifest lists.
  fonts?: FontRole[];
  // React pages bring their own layout, so main drops its width and padding.
  fullBleed?: boolean;
}

const { page } = Astro.props;
const title = page?.data.title ?? Astro.props.title;
const description = page?.data.description ?? Astro.props.description;
// mono is the menu's face, on every page.
const fonts = [...new Set<FontRole>(['mono', ...(Astro.props.fonts ?? []), ...(page?.data.fonts ?? [])])];

const groups = await getMenuGroups();
const current = Astro.url.pathname.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <HeadMeta title={title} description={description} page={page} />
    {fonts.map((role) => <Font cssVariable={fontVariable(role)} />)}
  </head>
  <body class="font-body text-neutral-900 bg-white">
    <SiteMenu groups={groups} current={current} />
    <main class={Astro.props.fullBleed ? undefined : 'mx-auto max-w-3xl px-4 pb-12'}>
      <slot />
    </main>
  </body>
</html>
