---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { fontVariable, type FontRole } from '../lib/fonts';
import HeadMeta from '../components/HeadMeta.astro';
import SiteHeader from '../components/SiteHeader.astro';
import type { Page } from '../lib/pages';

interface Props {
  title: string;
  description?: string;
  page?: Page;
  // Font roles the layout needs, added to any the page's manifest lists.
  fonts?: FontRole[];
  // React pages bring their own layout, so main drops its width and padding.
  fullBleed?: boolean;
}

const { page } = Astro.props;
const title = page?.data.title ?? Astro.props.title;
const description = page?.data.description ?? Astro.props.description;
const fonts = [...new Set([...(Astro.props.fonts ?? []), ...(page?.data.fonts ?? [])])];
---
<!doctype html>
<html lang="en">
  <head>
    <HeadMeta title={title} description={description} page={page} />
    {fonts.map((role) => <Font cssVariable={fontVariable(role)} />)}
  </head>
  <body class="font-body text-neutral-900 bg-white pt-12">
    <SiteHeader page={page} />
    <main class={Astro.props.fullBleed ? undefined : 'mx-auto max-w-3xl px-4 pt-12 pb-12'}>
      <slot />
    </main>
  </body>
</html>
