---
// Long-form layout for md pages, from the post design in Figma (docs/decisions.md,
// 2026-11-12): a section chip, title, dates and reading time in the headline role,
// the body in the editorial role on the grey wash. Tags stay in the manifest for RSS.
import Base from './Base.astro';
import { formatDate, sectionSlug, type Page } from '../lib/pages';

interface Props {
  page: Page;
  // The raw Markdown, used for the reading time.
  markdown: string;
}

const { page, markdown } = Astro.props;
const { title, date, updated, section } = page.data;
const words = markdown.split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.ceil(words / 230));
const back = section ? { href: `/${sectionSlug(section)}/`, label: section } : { href: '/', label: 'Home' };
---
<Base title={title} page={page} fonts={['headline', 'editorial']} background="wash">
  <article class="mx-auto max-w-[40rem] pt-8 md:pt-16">
    <header class="mb-10 font-headline">
      <p class="mb-4 text-sm leading-[1.42]">
        <a href={back.href} class="inline-block bg-white px-1.5 py-0.5 hover:underline">{back.label}</a>
      </p>
      <h1 class="mb-4 text-4xl font-semibold leading-tight">{title}</h1>
      <p class="text-sm leading-[1.42] text-neutral-600">
        <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
        {updated && (
          <> · Updated <time datetime={updated.toISOString().slice(0, 10)}>{formatDate(updated)}</time></>
        )}
        {` · ${minutes} min read`}
      </p>
    </header>
    <div
      class="font-editorial text-lg leading-relaxed
        [&_h2]:font-headline [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:leading-snug
        [&_h3]:font-headline [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:text-xl [&_h3]:font-semibold
        [&_h4]:font-headline [&_h4]:mt-6 [&_h4]:mb-2 [&_h4]:font-semibold
        [&_p]:mb-5 [&_a]:underline [&_ul]:mb-5 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:mb-5 [&_ol]:list-decimal [&_ol]:pl-6
        [&_li]:mb-1 [&_blockquote]:my-6 [&_blockquote]:border-l-2 [&_blockquote]:border-neutral-300 [&_blockquote]:pl-4
        [&_blockquote]:text-[1.75rem] [&_blockquote]:leading-[1.3] [&_blockquote]:italic [&_blockquote_p]:mb-0
        [&_code]:font-mono [&_code]:text-[0.85em] [&_pre]:my-6 [&_pre]:overflow-x-auto [&_pre]:rounded [&_pre]:bg-white [&_pre]:p-4
        [&_hr]:my-10 [&_img]:my-6 [&_img]:max-w-full"
    >
      <slot />
    </div>
  </article>
</Base>
